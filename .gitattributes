# Store text with LF in the repository; check out with the platform default.
* text=auto

# Windows tooling files keep CRLF in every checkout.
*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.props   text eol=crlf
*.ps1     text eol=crlf
*.rc      text eol=crlf

*.png binary
*.ico binary
*.bmp binary
